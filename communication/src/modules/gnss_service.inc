// GNSS sentence logging, latest-fix projection, and periodic receiver servicing.
struct __attribute__((packed)) GnssRawPayload{uint8_t rawLength,checksumValid,parsed,reserved;char type[6];char raw[kGnssMaxSentenceChars];};
struct __attribute__((packed)) GnssFixPayload{uint32_t flags;double latitude,longitude;float altitudeM,speedMps,courseDeg,hdop;uint8_t satellites,fixType;char utcTime[12],utcDate[8],lastType[7];uint64_t endUs,parseUs;};
struct __attribute__((packed)) GnssStatusPayload{uint32_t bytes,sentences,valid,checksumErrors,parseErrors,logDrops,sentenceAgeMs,fixAgeMs;};
void logSentence(const gnss::Sentence& s){GnssRawPayload raw{};raw.rawLength=min<uint8_t>(s.rawLength,kGnssMaxSentenceChars);raw.checksumValid=s.checksumValid;raw.parsed=s.parsed;strncpy(raw.type,s.type,sizeof(raw.type)-1);memcpy(raw.raw,s.raw,raw.rawLength);emitLocal(boat::Type::GnssRaw,&raw,sizeof(raw));if(!s.parsed)return;const auto& g=gnssRx.latest();GnssFixPayload fix{};fix.flags=g.flags;fix.latitude=g.latitude;fix.longitude=g.longitude;fix.altitudeM=g.altitudeM;fix.speedMps=g.speedMps;fix.courseDeg=g.courseDeg;fix.hdop=g.hdop;fix.satellites=g.satellites;fix.fixType=g.fixType;strncpy(fix.utcTime,g.utcTime,sizeof(fix.utcTime)-1);strncpy(fix.utcDate,g.utcDate,sizeof(fix.utcDate)-1);strncpy(fix.lastType,g.lastType,sizeof(fix.lastType)-1);fix.endUs=g.lastSentenceEndUs;fix.parseUs=g.lastParseUs;emitLocal(boat::Type::GnssFix,&fix,sizeof(fix));++fixSeq;pendingNewFix=true;lastFixUs=nowUs();}
boat::GnssNavV2Payload makeNav(){const auto& g=gnssRx.latest();boat::GnssNavV2Payload n{};n.navSequence=++navSeq;n.fixSequence=fixSeq;if(g.flags&gnss::FixValid)n.flags|=boat::NavFixValid;if(pendingNewFix)n.flags|=boat::NavNewFix;if(g.flags&gnss::LatitudeValid)n.flags|=boat::NavLatValid;if(g.flags&gnss::LongitudeValid)n.flags|=boat::NavLonValid;if(g.flags&gnss::AltitudeValid)n.flags|=boat::NavAltitudeValid;if(g.flags&gnss::SpeedValid)n.flags|=boat::NavSpeedValid;if(g.flags&gnss::CourseValid)n.flags|=boat::NavCourseValid;if(g.flags&gnss::HdopValid)n.flags|=boat::NavHdopValid;n.latitudeE7=lround(g.latitude*1e7);n.longitudeE7=lround(g.longitude*1e7);n.altitudeMm=lround(g.altitudeM*1000);n.speedMmPerSec=lround(g.speedMps*1000);n.courseE5Deg=lround(g.courseDeg*100000);n.hdopCenti=constrain(lround(g.hdop*100),0L,65535L);n.satellites=g.satellites;n.fixType=g.fixType;n.generatedUs=nowUs();n.measurementUs=g.lastValidFixUs?g.lastValidFixUs:n.generatedUs;n.sourceBootId=bootId;n.canonicalCrc=boat::canonicalCrc(&n,offsetof(boat::GnssNavV2Payload,canonicalCrc));return n;}
void serviceGnss(){for(uint16_t i=0;i<kGnssReadBudgetBytes&&gnssUart.available();++i){int c=gnssUart.read();if(c<0)break;gnss::Sentence s{};if(gnssRx.feed((char)c,nowUs(),s))logSentence(s);}gnssRx.expire(nowUs());if(millis()-lastGnssStatusMs>=1000){lastGnssStatusMs=millis();auto w=gnssRx.takeWindow();const auto& g=gnssRx.latest();GnssStatusPayload s{w.bytes,w.sentences,w.validSentences,w.checksumErrors,w.parseErrors,w.logDrops,ageMs(g.lastSentenceEndUs,nowUs()),ageMs(g.lastValidFixUs,nowUs())};emitLocal(boat::Type::GnssStatus,&s,sizeof(s));}}
